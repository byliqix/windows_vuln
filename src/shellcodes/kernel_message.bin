// Kernel Message Shellcode (x64)
// Goal: Call DbgPrint from kernel space to confirm execution.
unsigned char kernel_msg_shellcode[] = {
    0x48, 0x83, 0xEC, 0x20,                   // sub rsp, 0x20
    0x48, 0x8D, 0x0D, 0x00, 0x00, 0x00, 0x00, // lea rcx, [rel "Hello from Kernel"]
    0x48, 0xB8, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // mov rax, [DbgPrintAddr]
    0xFF, 0xD0,                               // call rax
    0x48, 0x83, 0xC4, 0x20,                   // add rsp, 0x20
    0xC3                                     // ret
};
